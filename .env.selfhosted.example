# FlexVault Self-Hosted Configuration
# Copy this file to .env and fill in your values.

# Required: JWT secret for token signing (at least 32 characters)
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long

# Database path (default: ./data/nodewarden.db)
DATABASE_PATH=./data/nodewarden.db

# Storage path for attachments (default: ./data/attachments)
STORAGE_PATH=./data/attachments

# Server port (default: 3000)
PORT=3000

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Optional: path to the built Web Vault (the Docker image sets this to /app/dist)
# FRONTEND_PATH=./dist

# Set to 1 only when the server is behind a reverse proxy you control.
# When enabled, X-Forwarded-Proto / X-Forwarded-Host / X-Real-IP are trusted.
# When disabled, spoofable client-IP headers are stripped and the socket address
# is used for rate limiting.
TRUST_PROXY=0

# Deprecated. Set to 1 only for old clients that put the access JWT in the
# WebSocket query string. The default (0) only accepts the one-time ?id= token
# or an Authorization: Bearer header.
ALLOW_LEGACY_WS_QUERY_TOKEN=0

# Hard cap for a single request body / attachment upload, in bytes.
# Default: 104857600 (100 MB). Reverse proxies also need a matching limit.
MAX_UPLOAD_BYTES=104857600

# WebAuthn / passkey configuration for reverse-proxy deployments.
# WEBAUTHN_RP_ID=vault.example.com
# WEBAUTHN_RP_NAME=FlexVault
# WEBAUTHN_ALLOWED_ORIGINS=https://vault.example.com

# Hide the Web Vault while keeping the API available.
# HIDE_WEB_VAULT=1
